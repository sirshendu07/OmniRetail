# Server Runtime Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Database Configuration (MongoDB Atlas Replica Set)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/omni_retail?retryWrites=true&w=majority

# Distributed Caching & Session Management (Redis / Upstash)
REDIS_URL=rediss://default:token@cluster.upstash.io:6379

# Event Streaming Infrastructure (Apache Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=omni-retail-service
KAFKA_GROUP_ID=omni-retail-consumer-group

# Authentication & Cryptographic Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_HMAC_SECRET=your_super_secret_otp_hmac_key_min_32_characters_long
CSRF_SECRET=your_super_secret_csrf_key_min_32_characters_long

# Nodemailer / Gmail SMTP Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary Image Management (Optional in local dev until configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Qdrant Cloud Vector Database (Optional in local dev until configured)
QDRANT_URL=
QDRANT_API_KEY=
