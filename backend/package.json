{
  "name": "omni-retail-backend",
  "version": "1.0.0",
  "description": "OmniRetail - Intelligent Omnichannel Commerce & Inventory Management System",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:unit": "node --test --test-concurrency=1 tests/unit/**/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/**/*.test.js",
    "test:concurrency": "node --test --test-concurrency=1 tests/concurrency/**/*.test.js",
    "seed": "node src/database/seed.js"
  },
  "keywords": [
    "retail",
    "distributed-systems",
    "inventory-management",
    "kafka",
    "redis",
    "mongodb",
    "event-driven",
    "concurrency",
    "gemini"
  ],
  "author": "OmniRetail Core Engineering Team",
  "license": "MIT",
  "dependencies": {
    "argon2": "^0.41.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.10.1",
    "nodemailer": "^6.10.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "razorpay": "^2.9.5",
    "zod": "^3.24.2"
  }
}
